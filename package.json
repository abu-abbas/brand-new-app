{
  "$schema": "https://www.schemastore.org/package.json",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "lint": "eslint .",
    "test": "npm run test:unit && npm run test:component",
    "test:unit": "node --experimental-strip-types --test 'resources/js/**/*.test.mjs'",
    "test:component": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "orval": "orval",
    "generate:api": "php artisan scramble:export --path=docs/openapi.json && npm run orval",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.0.0",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.11",
    "concurrently": "^9.0.1",
    "eslint": "^10.7.0",
    "eslint-plugin-vue": "^10.9.2",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "laravel-vite-plugin": "^3.1",
    "orval": "^7.11.2",
    "prettier": "^3.9.5",
    "tailwindcss": "^4.0.0",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@lucide/vue": "^1.25.0",
    "@tanstack/vue-query": "^5.101.4",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vueuse/core": "^14.3.0",
    "axios": "^1.7.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "element-plus": "^2.14.3",
    "pinia": "^3.0.4",
    "reka-ui": "^2.10.1",
    "shadcn-vue": "^2.7.4",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.39",
    "vue-router": "^4.5.0"
  },
  "overrides": {
    "tar": "^7.4.3"
  }
}
